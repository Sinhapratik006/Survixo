# ─────────────────────────────────────────────────────────────
# Nexovra configuration. Copy to `.env` and fill in values.
# Placeholder values only - never commit real secrets.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=8787
# Public URL of the web app (used for CORS/CSRF origin checks, OAuth and Stripe redirects)
APP_URL=http://localhost:5173
# Public URL of the API if served from a different origin (defaults to APP_URL)
# API_PUBLIC_URL=https://api.example.com
# Set to true when running behind a reverse proxy / load balancer
TRUST_PROXY=false

# PostgreSQL (npm run db:local starts one on port 5433 without Docker)
DATABASE_URL=postgresql://nexovra:nexovra@localhost:5433/nexovra
# Redis - required in production; optional in development (in-memory fallback)
# REDIS_URL=redis://localhost:6379

# Secrets - generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
API_KEY_PEPPER=replace-with-a-different-long-random-string-32-chars
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_MASTER_KEY=REPLACE_WITH_32_BYTES_BASE64_ENCODED_KEY_000000=
ENCRYPTION_KEY_VERSION=1
SESSION_TTL_DAYS=14

# Google sign-in (OAuth 2.0 / OpenID Connect). Leave empty to disable.
# Authorized redirect URI to register in Google Cloud Console:
#   http://localhost:5173/api/auth/google/callback   (development, via the Vite proxy)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Demo mode enables the synthetic demo adapter and seeded demo offers. Must be false in production.
DEMO_MODE=true
# demo = labelled non-monetary credits; stripe = real card payments via Stripe Checkout
BILLING_MODE=demo
SIGNUP_DEMO_CREDIT_USD=5
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# Platform fee in basis points (500 = 5%) deducted from seller earnings
PLATFORM_FEE_BPS=500

# Outbound URL safety. http:// endpoints are rejected unless explicitly allowed (development only).
ALLOW_INSECURE_ENDPOINTS=false
# Comma-separated hostnames explicitly approved to bypass private-network blocking (e.g. a local vLLM host)
PRIVATE_ENDPOINT_ALLOWLIST=
# Comma-separated emails that receive the platform ADMIN role at sign-up
ADMIN_EMAILS=

RUN_WORKERS=true
LOG_LEVEL=info
