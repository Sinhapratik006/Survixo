{
  "name": "nexovra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nexovra (working name) - a two-sided AI inference marketplace with a unified OpenAI-compatible API.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "next dev",
    "dev:server": "tsx watch --clear-screen=false server/src/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "next build",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node server/dist/index.js",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "db:local": "node scripts/local-db.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "ledger:reconcile": "tsx server/src/scripts/reconcile.ts",
    "test": "vitest run --project web --project server",
    "test:watch": "vitest --project web --project server",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "next:typecheck": "npx tsc -p tsconfig.app.json --noEmit && npx tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.104.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.59.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "jsdom": "^26.1.0",
    "next": "^15.2.0",
    "postcss": "^8.5.31",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^3.2.7"
  }
}
